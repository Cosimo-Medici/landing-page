{
  "directoryListing": false,
  "cleanUrls": false,
  "headers": [
    {
      "source": "**",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/re",
      "destination": "/re/index.html"
    },
    {
      "source": "/re/",
      "destination": "/re/index.html"
    },
    {
      "source": "/vc",
      "destination": "/vc/index.html"
    },
    {
      "source": "/vc/",
      "destination": "/vc/index.html"
    },
    {
      "source": "/pe",
      "destination": "/pe/index.html"
    },
    {
      "source": "/pe/",
      "destination": "/pe/index.html"
    },
    {
      "source": "/credit",
      "destination": "/credit/index.html"
    },
    {
      "source": "/credit/",
      "destination": "/credit/index.html"
    },
    {
      "source": "/hedge",
      "destination": "/hedge/index.html"
    },
    {
      "source": "/hedge/",
      "destination": "/hedge/index.html"
    },
    {
      "source": "/product-demo",
      "destination": "/product-demo/index.html"
    },
    {
      "source": "/product-demo/",
      "destination": "/product-demo/index.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/founders",
      "destination": "/founders.html"
    },
    {
      "source": "/accessibility",
      "destination": "/accessibility.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    }
  ]
}
